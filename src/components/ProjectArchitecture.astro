---
import type { ProjectArchitecture } from '../data/projects';

interface Props {
  architecture: ProjectArchitecture;
}

const { architecture } = Astro.props;
---

<figure class="architecture" aria-label="System architecture">
  <div class="architecture-flow">
    <div class="architecture-group architecture-inputs" role="group" aria-label="Inputs">
      <p class="architecture-label">Input</p>
      <ul>
        {architecture.inputs.map((input) => <li>{input}</li>)}
      </ul>
    </div>

    <div class="architecture-connector" aria-hidden="true"></div>

    <div class="architecture-group architecture-processes" role="group" aria-label="Processing">
      <p class="architecture-label">Processing</p>
      <ul>
        {architecture.processes.map((process) => <li>{process}</li>)}
      </ul>
    </div>

    <div class="architecture-connector" aria-hidden="true"></div>

    <div class="architecture-group architecture-outputs" role="group" aria-label="Outputs">
      <p class="architecture-label">Output</p>
      <ul>
        {architecture.outputs.map((output) => <li>{output}</li>)}
      </ul>
    </div>
  </div>

</figure>

<style>
  .architecture {
    margin: var(--space-4) 0;
  }

  .architecture-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1.35fr) 2.5rem minmax(0, 1fr);
    align-items: center;
  }

  .architecture-group {
    align-self: stretch;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    background: #faf9f6;
  }

  .architecture-processes {
    border-color: #9db3ea;
    background: #f4f7ff;
  }

  .architecture-outputs {
    border-color: var(--color-accent);
    background: #edf2ff;
  }

  .architecture-label {
    margin: 0 0 0.75rem;
    color: var(--color-link);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .architecture ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .architecture li {
    position: relative;
    margin: 0;
    padding-left: 1rem;
    color: var(--color-text);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .architecture li::before {
    position: absolute;
    top: 0.5em;
    left: 0;
    width: 0.38rem;
    height: 0.38rem;
    background: var(--color-accent);
    content: '';
  }

  .architecture-connector {
    position: relative;
    height: 1px;
    background: var(--color-accent);
  }

  .architecture-connector::after {
    position: absolute;
    top: 50%;
    right: -1px;
    width: 0.55rem;
    height: 0.55rem;
    border-top: 1px solid var(--color-accent);
    border-right: 1px solid var(--color-accent);
    content: '';
    transform: translateY(-50%) rotate(45deg);
  }

  @media (max-width: 44rem) {
    .architecture-flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .architecture-connector {
      width: 1px;
      height: 2.5rem;
      margin-left: var(--space-3);
    }

    .architecture-connector::after {
      top: auto;
      right: auto;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%) rotate(135deg);
    }

  }
</style>
