---
import { site } from '../data/site';

const navLinks = [
  { label: 'Experience', href: '/home/#experience' },
  { label: 'Projects', href: '/home/#projects' },
  { label: 'About Me', href: '/home/#about-me' },
];
---

<header class="nav">
  <div class="page nav-inner">
    <a class="wordmark" href="/home/">{site.name}</a>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle-icon" aria-hidden="true"></span>
    </button>

    <nav id="nav-menu" class="nav-menu" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li><a class="nav-link" href={link.href}>{link.label}</a></li>
        ))}
        <li><a class="nav-link" href={site.resumeHref} target="_blank" rel="noopener noreferrer">Resume</a></li>
        <li><a class="nav-link" href="/contact/">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>
<div class="nav-spacer" aria-hidden="true"></div>

<style>
  .nav {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 10;
    background: transparent;
    pointer-events: none;
  }

  .nav-spacer {
    min-height: 10rem;
  }

  .nav-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    max-width: none;
    margin: 0;
    padding: 0 clamp(2rem, 5vw, 5rem) 0 0;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(1.2rem, 2vw, 1.75rem);
    text-decoration: none;
    color: var(--color-link);
    pointer-events: auto;
  }

  .nav-menu ul {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu,
  .nav-toggle {
    pointer-events: auto;
  }

  .nav-menu a {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    text-decoration: underline;
  }

  .nav-link {
    color: var(--color-link);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--color-link);
    padding: 0.4rem 0.6rem;
    cursor: pointer;
  }

  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: var(--color-link);
    position: relative;
  }

  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle-icon::before {
    top: -5px;
  }

  .nav-toggle-icon::after {
    top: 5px;
  }

  @media (max-width: 640px) {
    .nav-inner {
      padding-right: var(--space-2);
    }

    .nav-spacer {
      min-height: 2.5rem;
    }

    .nav-toggle {
      display: block;
    }

    .nav-menu {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-menu.is-open {
      display: block;
    }

    .nav-menu ul {
      flex-direction: column;
      gap: 0;
    }

    .nav-menu li {
      border-top: 1px solid var(--color-border);
    }

    .nav-menu a {
      display: block;
      padding: var(--space-2) var(--space-3);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.nav');
  const spacer = document.querySelector<HTMLElement>('.nav-spacer');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  if (header && spacer) {
    const resizeObserver = new ResizeObserver(() => {
      spacer.style.height = `${header.offsetHeight}px`;
    });
    resizeObserver.observe(header);
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') {
      menu.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
