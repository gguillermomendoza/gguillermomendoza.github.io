---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page footer-inner">
    <p>&copy; {year} {site.fullName}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    padding: var(--space-3);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .footer-inner p {
    margin: 0;
  }
</style>
