---
import { site } from '../data/site';

const year = new Date().getFullYear();
const entries = [
  { name: 'site.ts', meta: `owner: ${site.fullName}` },
  { name: 'LICENSE', meta: `© ${year}` },
  { name: '.last-modified', meta: '2026-08-07' },
];
---

<footer class="site-footer">
  <div class="page footer-inner">
    <p class="bracket-label footer-label">directory listing</p>
    <ul class="footer-files">
      {entries.map((entry) => (
        <li>
          <span class="footer-file-name">{entry.name}</span>
          <span class="footer-file-meta">{entry.meta}</span>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px dotted var(--color-border);
  }

  .footer-inner {
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .footer-label {
    margin: 0 0 var(--space-2);
  }

  .footer-files {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-files li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    max-width: 24rem;
  }

  .footer-file-name {
    color: var(--color-text);
  }
</style>
