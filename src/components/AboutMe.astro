---
import { aboutMe, site } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---

<section id="about-me">
  <div class="page">
    <div class="section-heading">
      <h2>{aboutMe.heading}</h2>
    </div>

    <p class="about-me-copy">{aboutMe.background}</p>
    <p class="about-me-cta">{aboutMe.cta}</p>

    <div class="about-me-links">
      <a class="btn" href={`mailto:${site.email}`}>Email</a>
      <a class="btn btn-quiet" href={site.linkedin} target="_blank" rel="noopener noreferrer">
        <SocialIcon name="linkedin" />
        LinkedIn
      </a>
      <a class="btn btn-quiet" href={site.github} target="_blank" rel="noopener noreferrer">
        <SocialIcon name="github" />
        GitHub
      </a>
    </div>
  </div>
</section>

<style>
  #about-me > .page {
    max-width: 1200px;
  }

  .about-me-copy,
  .about-me-cta {
    max-width: none;
  }

  .about-me-cta {
    font-size: 1.2rem;
    font-weight: 500;
  }

  .about-me-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>
