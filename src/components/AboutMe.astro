---
import { aboutMe, site } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---

<section id="about-me">
  <div class="page">
    <div class="section-heading">
      <h2>{aboutMe.heading}</h2>
    </div>

    <p class="about-me-copy">{aboutMe.background}</p>
    <p class="about-me-cta">{aboutMe.cta}</p>

    <div class="about-me-links">
      <a class="social-link" href={`mailto:${site.email}`}>
        <SocialIcon name="email" />
        Email
      </a>
      <a class="social-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">
        <SocialIcon name="linkedin" />
        LinkedIn
      </a>
      <a class="social-link" href={site.github} target="_blank" rel="noopener noreferrer">
        <SocialIcon name="github" />
        GitHub
      </a>
    </div>
  </div>
</section>

<style>
  #about-me > .page {
    max-width: 1200px;
  }

  .about-me-copy,
  .about-me-cta {
    max-width: none;
  }

  .about-me-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-5);
    row-gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .about-me-links a {
    color: var(--color-link);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    text-decoration: underline;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
