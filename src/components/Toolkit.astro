---
import { skillGroups } from '../data/skills';
---

<section id="toolkit" class="toolkit">
  <div class="page">
    <div class="section-heading toolkit-heading">
      <h2>
        <button
          class="toolkit-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="toolkit-content"
        >Toolkit</button>
      </h2>
    </div>

    <div id="toolkit-content" class="toolkit-reveal" aria-hidden="true">
      <div class="toolkit-reveal-inner">
        <dl class="toolkit-grid">
          {skillGroups.map((group) => (
            <div class="toolkit-group">
              <dt>{group.category}</dt>
              <dd>{group.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .toolkit-heading {
    margin-bottom: 0;
  }

  .toolkit h2 {
    font-size: 1.3rem;
  }

  .toolkit-toggle {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-link);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .toolkit-toggle:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
  }

  .toolkit-reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem) scaleY(0.98);
    transform-origin: top;
    transition:
      grid-template-rows 180ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 120ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 180ms;
  }

  .toolkit.is-open .toolkit-reveal {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scaleY(1);
    transition-delay: 0s;
  }

  .toolkit-reveal-inner {
    min-height: 0;
    overflow: hidden;
  }

  .toolkit-grid {
    display: grid;
    grid-template-columns: 10rem 1fr;
    row-gap: var(--space-2);
    column-gap: var(--space-3);
    margin: var(--space-4) 0 0;
  }

  .toolkit-group {
    display: contents;
  }

  .toolkit-group dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding-top: 0.15rem;
  }

  .toolkit-group dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .toolkit-grid {
      grid-template-columns: 1fr;
      row-gap: 0.2rem;
    }

    .toolkit-group {
      display: block;
      margin-bottom: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toolkit-reveal {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const toolkit = document.querySelector<HTMLElement>('#toolkit');
  const toggle = toolkit?.querySelector<HTMLButtonElement>('.toolkit-toggle');
  const content = toolkit?.querySelector<HTMLElement>('#toolkit-content');
  const portfolio = toolkit?.closest<HTMLElement>('.portfolio-grid');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const stackedLayout = window.matchMedia('(max-width: 64rem)');
  let transitionTimer = 0;

  toggle?.addEventListener('click', () => {
    if (!toolkit || !content || !portfolio) return;

    window.clearTimeout(transitionTimer);
    const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
    const layoutDelay = reducedMotion.matches || stackedLayout.matches ? 0 : 50;

    toggle.setAttribute('aria-expanded', String(willOpen));

    if (willOpen) {
      portfolio.classList.add('toolkit-open');
      transitionTimer = window.setTimeout(() => {
        toolkit.classList.add('is-open');
        content.setAttribute('aria-hidden', 'false');
      }, layoutDelay);
    } else {
      toolkit.classList.remove('is-open');
      content.setAttribute('aria-hidden', 'true');
      transitionTimer = window.setTimeout(() => {
        portfolio.classList.remove('toolkit-open');
      }, reducedMotion.matches || stackedLayout.matches ? 0 : 50);
    }
  });
</script>
