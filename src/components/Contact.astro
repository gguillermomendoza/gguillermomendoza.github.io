---
import { contact, site } from '../data/site';
---

<section id="contact">
  <div class="page">
    <div class="section-heading">
      <h2>{contact.heading}</h2>
    </div>

    <p class="contact-cta">{contact.cta}</p>

    <div class="contact-links">
      <a class="btn" href={`mailto:${site.email}`}>Email</a>
      <a class="btn btn-quiet" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="btn btn-quiet" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    max-width: var(--measure);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>
