---
// Quiet diagnostic-readout artifact: an idling noisy waveform that flinches
// near the cursor, like a live EEG channel left running in the corner of a lab.
// Freezes to a static frame under prefers-reduced-motion.
---

<div class="page signal-strip-wrap">
  <div class="signal-strip" data-cursor="inspect">
    <span class="scan-corner scan-corner-tl"></span>
    <span class="scan-corner scan-corner-tr"></span>
    <span class="scan-corner scan-corner-bl"></span>
    <span class="scan-corner scan-corner-br"></span>

    <canvas id="signal-canvas" class="signal-canvas" height="72" aria-hidden="true"></canvas>

    <div class="signal-readout">
      <span>ch. 01&ndash;04 &middot; live</span>
      <span>n = 128 channels</span>
      <span>fs = 250 Hz</span>
      <span id="signal-counter">t+0000s</span>
    </div>
  </div>
</div>

<style>
  .signal-strip-wrap {
    padding-top: var(--space-4);
  }

  .signal-strip {
    position: relative;
    padding: var(--space-2) var(--space-2) var(--space-1);
    border: 1px dotted var(--color-border);
    background: var(--color-bg-raised);
  }

  .signal-canvas {
    display: block;
    width: 100%;
    height: 72px;
  }

  .signal-readout {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  #signal-counter {
    margin-left: auto;
  }
</style>

<script>
  const canvas = document.getElementById('signal-canvas') as HTMLCanvasElement | null;
  const counter = document.getElementById('signal-counter');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let width = 0;
    let height = 72;
    let mouseX = -9999;
    let t = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = (staticFrame = false) => {
      if (!ctx || width === 0) return;
      ctx.clearRect(0, 0, width, height);
      ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--color-accent').trim() || '#1a4fd6';
      ctx.lineWidth = 1;
      ctx.beginPath();

      const mid = height / 2;
      const points = Math.floor(width);

      for (let i = 0; i <= points; i += 2) {
        const noise = Math.sin(i * 0.08 + t) * 6 + Math.sin(i * 0.021 + t * 1.7) * 10;
        const proximity = Math.max(0, 1 - Math.abs(i - mouseX) / 60);
        const flinch = proximity * Math.sin(i * 0.6 + t * 6) * 14;
        const y = mid + noise + flinch;
        if (i === 0) ctx.moveTo(i, y);
        else ctx.lineTo(i, y);
      }

      ctx.stroke();

      if (!staticFrame) t += 0.05;
    };

    resize();
    window.addEventListener('resize', resize);

    if (reduceMotion) {
      draw(true);
    } else {
      window.addEventListener('mousemove', (event) => {
        const rect = canvas.getBoundingClientRect();
        mouseX = event.clientX - rect.left;
      });

      let seconds = 0;
      const tick = () => {
        draw();
        requestAnimationFrame(tick);
      };
      tick();

      setInterval(() => {
        seconds += 1;
        if (counter) counter.textContent = `t+${String(seconds).padStart(4, '0')}s`;
      }, 1000);
    }
  }
</script>
