---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArchitecture from '../../components/ProjectArchitecture.astro';
import ProjectImages from '../../components/ProjectImages.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const pageTitle = `${project.title} — Guillermo Mendoza`;
---

<BaseLayout title={pageTitle} description={project.problem}>
  <article class="project">
    <div class="page">
      <a class="link back-link" href="/home/#projects">&larr; Projects</a>

      <p class="path-tag">/projects/{project.slug}/</p>
      <h1>{project.title}</h1>
      <p class="project-problem">{project.problem}</p>

      <ul class="tech-list">
        {project.tech.map((t) => <li>{t}</li>)}
      </ul>

      <div class="project-links">
        <a class="link" href={project.github} target="_blank" rel="noopener noreferrer">View repository</a>
        {project.document && (
          <a class="link" href={project.document.href} target="_blank" rel="noopener noreferrer">
            {project.document.label}
          </a>
        )}
        {project.relatedGithub && (
          <a class="link" href={project.relatedGithub.href} target="_blank" rel="noopener noreferrer">
            {project.relatedGithub.label}
          </a>
        )}
      </div>

      {project.images && project.images.length > 0 && project.imagePlacement !== 'results' && (
        <ProjectImages images={project.images} />
      )}

      <div class="project-sections">
        <section>
          <h2>Overview</h2>
          <p>{project.detail.overview}</p>
          {project.architecture && <ProjectArchitecture architecture={project.architecture} />}
        </section>

        <section>
          <h2>Problem</h2>
          <p>{project.detail.problem}</p>
        </section>

        <section>
          <h2>Approach</h2>
          <p>{project.detail.approach}</p>
        </section>

        <section>
          <h2>Technical Implementation</h2>
          <p>{project.detail.implementation}</p>
        </section>

        <section>
          <h2>Evaluation &amp; Results</h2>
          <p>{project.detail.evaluation}</p>
          {project.images && project.images.length > 0 && project.imagePlacement === 'results' && (
            <ProjectImages images={project.images} />
          )}
        </section>

        <section>
          <h2>What I Learned</h2>
          <p>{project.detail.learned}</p>
        </section>
      </div>

      <a class="link" href={project.github} target="_blank" rel="noopener noreferrer">View repository on GitHub</a>
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    padding: var(--space-5) 0 var(--space-6);
  }

  .project > .page {
    max-width: var(--portfolio-max);
    padding: 0;
  }

  .project :global(p) {
    max-width: none;
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-size: 0.9rem;
  }

  .project > .page > .path-tag {
    margin: 0 0 0.3rem;
  }

  .project-problem {
    font-weight: 500;
    font-size: 1.2rem;
    color: var(--color-text-muted);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    margin: var(--space-3) 0 var(--space-4);
  }

  .project-sections section {
    padding: var(--space-3) 0 var(--space-4);
    border-bottom: none;
  }

  .project-sections h2 {
    font-size: 1.2rem;
  }

  @media (max-width: 64rem) {
    .project > .page {
      max-width: var(--page-max);
    }
  }
</style>
