---
import { projects } from '../data/projects';
import { site } from '../data/site';

const projectUrls = projects.map((project) => `/projects/${project.slug}/`);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
  </head>
  <body>
    <main>
      <h1>{site.name}</h1>

      <nav aria-label="Choose a destination">
        <a href="/home/">Home</a>
        <a id="random-project" href="/home/#projects" data-projects={JSON.stringify(projectUrls)}>
          Random project
        </a>
        <a href={site.resumeHref} target="_blank" rel="noopener noreferrer">Resume</a>
        <a href="/contact/">Contact me</a>
      </nav>
    </main>

    <script>
      const randomLink = document.querySelector<HTMLAnchorElement>('#random-project');
      const destinations = JSON.parse(randomLink?.dataset.projects ?? '[]') as string[];

      const chooseProject = () => destinations[Math.floor(Math.random() * destinations.length)];

      if (randomLink && destinations.length > 0) {
        randomLink.href = chooseProject();
        randomLink.addEventListener('click', () => {
          randomLink.href = chooseProject();
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #fff;
    color: #000;
    color-scheme: light;
    font-family: 'Times New Roman', Times, serif;
  }

  :global(body) {
    margin: 0;
    padding: clamp(1rem, 2vw, 2rem);
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.55;
  }

  main {
    max-width: 58rem;
  }

  h1 {
    margin: 0 0 0.35em;
    font-size: clamp(2.75rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 0.95;
  }

  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  a {
    color: #0000ee;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  a:focus-visible {
    outline: 2px solid #0000ee;
    outline-offset: 3px;
  }

</style>
